{
  "name": "The Nest",
  "description": "A home for your research.",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Open The Nest"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "nest.html"
  },
  "icons": {
    "16": "logo/icon16.png",
    "32": "logo/icon32.png",
    "48": "logo/icon48.png",
    "128": "logo/icon128.png"
  }
}