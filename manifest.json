{
  "name": "The Nest",
  "description": "A home for your research.",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [
    "sidePanel"
  ],
  "action": {
    "default_title": "Open The Nest"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "nest.html"
  }
}